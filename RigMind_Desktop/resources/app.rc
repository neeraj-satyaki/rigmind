      VALUE "CompanyName", "Satyaki Solutions Pvt Ltd"
      VALUE "FileDescription", "RigMind"
      VALUE "ProductName", "RigMind"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
